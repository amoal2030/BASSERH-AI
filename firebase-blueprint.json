{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with Google account info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "google_id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "profile_image": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "google_id", "name", "email", "created_at"]
    },
    "Page": {
      "title": "Page",
      "description": "User feedback question page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "question": { "type": "string" },
        "slug": { "type": "string" },
        "max_comments": { "type": "number" },
        "comments_count": { "type": "number" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "user_id", "question", "slug", "created_at"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by UID"
    },
    "/pages/{pageId}": {
      "schema": "Page",
      "description": "Public question pages"
    }
  }
}
